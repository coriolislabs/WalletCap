        { "op": "settle", "id": "c", "expect": { "state": "settled" } },
        { "op": "hold", "amount": 1, "expect": { "refused": "budget", "source": "budget", "brief": "$0.000001 would bring 0xd797…ca02 to $150.000001 in the last 24h, over its $150.00 limit ($0.00 left)" } },
        { "op": "status", "expect": { "spent": 150000000, "in_flight": 0, "remaining": 0, "payments": 3, "frozen": false } }
      ]
    },
