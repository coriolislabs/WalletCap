# The fake awal stand-in in the tests is committed on purpose: the CLI test
# needs its dist/ layout, and the dist rule above would hide it.
!packages/js/test/support/fake-awal/dist/
!packages/js/test/support/fake-awal/dist/**

# Copies of spec/*.sql, made by the build: the files at spec/ are the source.
packages/python/src/walletcap/spec/

