{
  "name": "walletcap",
  "version": "0.4.0",
  "description": "Spend limits for AI agent wallets: a per-payment cap and rolling 24-hour USDC budget that holds across restarts, replicas on one host and payment rails, kept in one SQLite ledger. Adapters for x402, Coinbase CDP spend controls, AgentKit and the Agentic Wallet.",
  "license": "Apache-2.0",
  "author": "Coriolis Labs Inc.",
  "type": "module",
  "keywords": [
    "ai-agents",
    "ai-agent",
    "agent-wallet",
    "agent-payments",
    "spending-limit",
    "spend-limit",
    "budget",
    "x402",
    "coinbase",
    "coinbase-cdp",
    "cdp",
    "agentkit",
    "agentic-wallet",
    "spend-permissions",
    "usdc",
    "stablecoin",
    "base",
    "guardrails"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./x402": {
      "types": "./dist/adapters/x402.d.ts",
      "default": "./dist/adapters/x402.js"
    },
    "./cdp": {
      "types": "./dist/adapters/cdp.d.ts",
      "default": "./dist/adapters/cdp.js"
    },
    "./agentkit": {
      "types": "./dist/adapters/agentkit.d.ts",
      "default": "./dist/adapters/agentkit.js"
    },
    "./agentic": {
      "types": "./dist/adapters/agentic.d.ts",
      "default": "./dist/adapters/agentic.js"
    }
  },
  "bin": {
    "walletcap": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/copy-spec.mjs",
    "test": "npm run build && node --test --test-concurrency=2 \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "1.60.0",
    "@types/node": "22.20.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "viem": "2.37.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coriolislabs/WalletCap.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/coriolislabs/WalletCap/tree/main/packages/js#readme",
  "bugs": {
    "url": "https://github.com/coriolislabs/WalletCap/issues"
  }
}
