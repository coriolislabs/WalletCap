{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "newLine": "lf",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
