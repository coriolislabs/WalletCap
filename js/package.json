{
  "name": "walletcap",
  "version": "0.2.3",
  "description": "One spend budget per wallet for AI agents: counted across every process, replica, key, permission and payment rail. Restarts don't reset it, limit changes don't zero it, and if it can't be read nothing is paid.",
  "license": "Apache-2.0",
  "author": "Coriolis Labs Inc.",
  "type": "module",
  "keywords": [
    "ai-agents",
    "agent-payments",
    "x402",
    "spend-limit",
    "budget",
    "usdc",
    "coinbase",
    "cdp",
    "stablecoin",
    "guardrails"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./agentic": "./agentic.mjs"
  },
  "bin": {
    "walletcap": "cli.mjs"
  },
  "files": [
    "_keccak.mjs",
    "agentic.mjs",
    "cdp.mjs",
    "cli.mjs",
    "errors.mjs",
    "index.d.ts",
    "index.mjs",
    "ledger.mjs",
    "money.mjs",
    "x402.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "1.60.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "typescript": "5.6.3",
    "viem": "2.37.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coriolislabs/WalletCap.git",
    "directory": "js"
  },
  "homepage": "https://github.com/coriolislabs/WalletCap#readme",
  "bugs": {
    "url": "https://github.com/coriolislabs/WalletCap/issues"
  }
}
