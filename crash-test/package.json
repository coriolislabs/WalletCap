{
  "name": "walletcap-crash-test",
  "version": "0.2.0",
  "description": "Crash-test an AI agent's spend limits: restart it, scale it, change the asset, and count the dollars that get past the cap. Offline: nothing is sent.",
  "license": "Apache-2.0",
  "author": "Coriolis Labs Inc.",
  "type": "module",
  "bin": {
    "walletcap-crash-test": "cli.mjs"
  },
  "files": [
    "agent.mjs",
    "agentkit-agent.mjs",
    "cli.mjs",
    "contracts/coinbase-base-mainnet.json",
    "contracts/walletcap.json",
    "spend-permissions.mjs",
    "spend-store.mjs",
    "README.md"
  ],
  "scripts": {
    "start": "node cli.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.61.0",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/extensions": "2.30.0",
    "@x402/svm": "2.30.0",
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "viem": "2.57.16",
    "walletcap": "0.2.3"
  },
  "devDependencies": {
    "solc": "0.8.28"
  },
  "peerDependencies": {
    "@coinbase/agentkit": "0.10.4"
  },
  "peerDependenciesMeta": {
    "@coinbase/agentkit": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coriolislabs/WalletCap.git",
    "directory": "crash-test"
  },
  "homepage": "https://github.com/coriolislabs/WalletCap/tree/main/crash-test#readme"
}
