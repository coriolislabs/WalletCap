    "ai-agents",
    "agent-wallet",
    "spending-limit",
    "spend-limit",
    "crash-test",
    "x402",
    "coinbase",
    "coinbase-cdp",
    "cdp-sdk",
    "agentkit",
    "spend-permissions",
    "usdc",
    "base",
    "walletcap"
  ],
  "license": "Apache-2.0",
  "author": "Coriolis Labs Inc.",
  "type": "module",
  "bin": {
    "walletcap-crash-test": "cli.mjs"
  },
  "files": [
    "agent.mjs",
    "agentkit-agent.mjs",
    "cli.mjs",
    "contracts/coinbase-base-mainnet.json",
    "contracts/walletcap.json",
    "spend-permissions.mjs",
    "spend-store.mjs",
    "README.md"
  ],
  "scripts": {
